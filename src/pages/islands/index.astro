---
import MainLayout from "@layouts/MainLayout.astro";
import Title from "@components/shared/Title.astro";
import { Counter } from "@components/counter";

const counterValue = 20;
---

<MainLayout title="favoritos">
  <Title>Favoritos</Title>

  <video controls="" autoplay="" transition:persist>
    <source
      src="https://archive.org"
      type="video/mp4"
    />
  </video>

  <div
    style={{
      height: '2000px',
      backgroundColor: 'red',
      opacity: 0.4,
    }}
  >
  </div>

  <Counter
    {...{ "transition:persist": "counter", "transition:persist-props": true }}
    client:visible
    initValue={counterValue}
  />

  <Title>Counter island</Title>
</MainLayout>

