---
import type { GetStaticPaths } from "astro";
import PokemonCard from "../../components/pokemons/PokemonCard.astro";
import type { PokemonListResponse } from "../../interfaces/interfaces/pokemon-list.respond";

import MainLayout from "../../layouts/MainLayout.astro";



export const getStaticPaths = (async({paginate}) => {
  
  const resp = await fetch("https://pokeapi.co/api/v2/pokemon?limit=151");
  const {results} = (await resp.json()) as PokemonListResponse;
  return paginate(results, {pageSize: 20
  });
}) satisfies GetStaticPaths;


const title = "pokemon static | home";
const { page } = Astro.props;
---

<MainLayout title={title}>
  <h1 class="text-3xl">Listado de Pokémones</h1>
  <hr />  

  <section
  aria-label = "Listado de Pokemons"
  class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-5 gap-4 mt-5"> 

  {page.data.map(({name, url }) => (
  <PokemonCard
  name={name}
  url={url}
  />
  ))}
  </section>
  <section
  class="flex mt-10 gap-2 items-center"
  >
  <a href={page.url.prev} class="bg-blue-500 p-2 text-white rounded-md">Anteriores</a>
  <a href={page.url.next} class="bg-blue-500 p-2 text-white rounded-md">Siguientes</a>
  <div class="flex flex-1"></div>
  <span>Pagina 1</span>

  </section>
</MainLayout>
